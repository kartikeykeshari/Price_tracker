NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/price-tracker
JWT_SECRET=replace-with-at-least-32-random-bytes-before-running

# Optional for local development. Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PricePulse <tracker@example.com>"

# Cashfree credentials. Choose sandbox for test keys, production for live keys.
# Cashfree uses the client secret to verify webhook signatures. Never expose these to the client.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Comma-separated exact account emails that receive the admin console. Create and verify these accounts first.
ADMIN_EMAILS=kesharikartikey9140@gmail.com
# Stable secret used to prevent repeat starter grants from the same network. Keep it at 32+ random bytes.
FREE_TRIAL_SECRET=

# Optional social sign-in. Register these redirect URIs with each provider:
# http://localhost:5173/api/auth/google/callback and http://localhost:5173/api/auth/microsoft/callback
# In production, use https://your-domain/api/auth/google/callback and /api/auth/microsoft/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Set to the exact number of trusted reverse-proxy hops when deployed behind a proxy.
TRUST_PROXY_HOPS=0
