NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/price-tracker
JWT_SECRET=replace-with-at-least-32-random-bytes-before-running

# Optional for local development. Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Price Tracker <tracker@example.com>"

# Stripe test/live secret key and webhook signing secret. Never expose these to the client.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated exact account emails that receive the admin console. Create and verify these accounts first.
ADMIN_EMAILS=kesharikartikey9140
# Stable secret used to prevent repeat starter grants from the same network. Keep it at 32+ random bytes.
FREE_TRIAL_SECRET=

# Set to the exact number of trusted reverse-proxy hops when deployed behind a proxy.
TRUST_PROXY_HOPS=0
