NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/price-tracker
JWT_SECRET=replace-with-at-least-32-random-bytes-before-running

# Optional for local development. Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Price Tracker <tracker@example.com>"

# Set to the exact number of trusted reverse-proxy hops when deployed behind a proxy.
TRUST_PROXY_HOPS=0
