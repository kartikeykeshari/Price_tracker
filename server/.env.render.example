# Copy these keys into the Render service Environment settings and replace placeholders.
# Do not upload real secrets to Git or use the placeholder values in production.
NODE_ENV=production
CLIENT_URL=https://your-frontend-domain.example
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
FREE_TRIAL_SECRET=replace-with-a-different-random-secret-at-least-32-bytes-long

# Email verification and account alerts require a working SMTP service.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
MAIL_FROM=PricePulse <tracker@example.com>

# Required by current production startup validation. Use sandbox credentials first.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=replace-with-cashfree-client-id
CASHFREE_CLIENT_SECRET=replace-with-cashfree-client-secret
ADMIN_EMAILS=your-admin@example.com

# Optional OAuth. Configure both values for a provider or leave both unset.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Leave at 0 unless you have confirmed the number of trusted proxies in front of Render.
TRUST_PROXY_HOPS=0
